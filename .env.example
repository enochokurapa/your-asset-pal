# ---------- Public browser configuration ----------
# These VITE_* values may be embedded into the browser bundle.
VITE_SUPABASE_URL=https://your-app.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=

# ---------- Server-only Supabase configuration ----------
# NEVER prefix the service-role key with VITE_.
SUPABASE_URL=https://your-app.example.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_AUTH_INTERNAL_URL=http://ams-auth:9999
SUPABASE_REST_INTERNAL_URL=http://ams-rest:3000

# ---------- PostgreSQL backup/restore ----------
# Use the private/internal database hostname when the app and database share Docker networking.
DATABASE_URL=postgresql://postgres:replace-with-password@ams-db:5432/ams

# ---------- Cloudflare R2 ----------
# Create a PRIVATE Standard R2 bucket and an Object Read & Write token scoped only to that bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=assetflow-backups
# Optional. Leave blank for the default R2 endpoint.
# Example: https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
# Set true only when an external scheduler is used instead of the built-in scheduler.
BACKUP_SCHEDULER_DISABLED=false

# ---------- Backup email ----------
# The Email action sends a private one-hour R2 download link.
RESEND_API_KEY=
BACKUP_EMAIL_FROM=AssetFlow Backups <backups@example.com>

# ---------- Payment gateway (existing feature) ----------
YO_API_USERNAME=
YO_API_PASSWORD=
YO_API_MODE=production
YO_API_URL=
